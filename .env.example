###############################################################################
# scanspot — configuration
#
#   cp .env.example .env    then edit the four values marked REQUIRED.
#
# Every variable below is read by app/config.py. Defaults shown are the ones
# the code falls back to, so you only need to set what you want to change.
###############################################################################

# ─────────────────────────────────────────────────────────────────── NetBox ──
# REQUIRED. The NetBox you want populated. Include the scheme and the port.
NETBOX_URL=http://netbox.example.com:8080

# REQUIRED. A write-enabled API token. In NetBox: your user > API Tokens > Add.
NETBOX_TOKEN=

# Set to true if NetBox is served over HTTPS with a certificate your container
# trusts. Leave false for plain HTTP or a self-signed certificate.
NETBOX_VERIFY_SSL=false

# The site every discovered object is filed under. Created if it is missing.
NETBOX_SITE=Main Site

# Free-text label used in the site description and log lines.
CLIENT_NAME=Example Org

# Mask assumed for a discovered address when no routed interface and no
# existing NetBox prefix covers it.
DEFAULT_PREFIX_LEN=24

# ────────────────────────────────────────────────────────────────── scanner ──
SCAN_INTERVAL_MINUTES=20
RUN_ON_START=true
LOG_LEVEL=INFO

# Collect and log every intended write without touching NetBox. Run your first
# cycle this way — it is the safest possible introduction to the tool.
DRY_RUN=false

# Paths inside the container. Change only if you remap the volumes.
INVENTORY_FILE=/app/inventory.yml
STATE_DIR=/app/state

# ──────────────────────────────────────────────────────────── local store ────
# scanspot's own database — independent of whichever backend it syncs to.
#
# Default: SQLite inside the state volume. Nothing else to run, backup is a
# file copy, and it is the right choice for a single-node appliance.
#
# PostgreSQL is opt-in and only needed if you want to run more than one replica:
# SQLite means the cycle lock is a file lock (single node), while PostgreSQL
# makes pg_advisory_lock() available, which works across pods.
#
#   SCANSPOT_DB_URL=postgresql+psycopg://scanspot:pw@postgres:5432/scanspot
#
# Do NOT point this at your NetBox database. scanspot must own its own state.
SCANSPOT_DB_URL=

# Encrypts credential secrets stored inline in the database. Only required if
# you manage credentials through the API/plugin; profiles that reference an
# environment variable never need it.
#
#   docker compose exec scanner python -m app.store.crypto --generate
SCANSPOT_SECRET_KEY=

# ─────────────────────────────────────────────────────────────────── API ────
# HTTP API over the store — manage scan targets, trigger a scan, and let other
# systems consume the discovery data. OpenAPI docs at /api/docs.
#
# On first start scanspot generates an API key and prints it to the log ONCE.
# Only its hash is stored, so save it there and then.
#
# It speaks plain HTTP and has no rate limiting: keep it on the management
# network, or put TLS and a reverse proxy in front of it.
API_ENABLED=true
API_HOST=0.0.0.0
API_PORT=8080

# Container timezone, used for log timestamps.
TZ=UTC

# ───────────────────────────────────────────────────────────── SNMP defaults ──
# These build the implicit "default" credential profile. Devices in NetBox
# point at a profile *by name*; the secret itself never leaves this file.
# Define extra profiles in inventory.yml and reference these with ${VAR}.
SNMP_DEFAULT_VERSION=2c
SNMP_COMMUNITY=
SNMP_TIMEOUT=5
SNMP_RETRIES=1

# A switch port that has learned more MACs than this is treated as a trunk:
# its MACs are still recorded, but no access-port location is attached to them.
# Lower it if every endpoint appears on one port.
SNMP_UPLINK_MAC_THRESHOLD=12

# SNMPv3. Used when SNMP_DEFAULT_VERSION=3, or by a profile that asks for it.
# security level: noAuthNoPriv | authNoPriv | authPriv
# auth protocol:  MD5 | SHA | SHA-224 | SHA-256 | SHA-384 | SHA-512
# priv protocol:  DES | AES | AES-192 | AES-256
SNMP_V3_USERNAME=
SNMP_V3_SECURITY_LEVEL=authPriv
SNMP_V3_AUTH_PROTOCOL=SHA
SNMP_V3_AUTH_PASSWORD=
SNMP_V3_PRIV_PROTOCOL=AES
SNMP_V3_PRIV_PASSWORD=

# ───────────────────────────────────────────────────── FortiGate defaults ────
# These build the implicit "fortigate-default" credential profile.
# The token comes from a REST API Admin with READ on System, Network and Router,
# and Trusted Hosts restricted to this host's /32. See the README.
FORTIGATE_API_TOKEN=
FORTIGATE_PORT=443
FORTIGATE_VDOM=root
FORTIGATE_VERIFY_SSL=false
FORTIGATE_TIMEOUT=20

# ───────────────────────────────────────────────────────────── first-run seed ──
# Optional shortcut so the NetBox GUI is not empty on day one. Each of these
# creates ONE device, tagged "scan-target", on the FIRST run only. After that
# NetBox is authoritative: add and remove devices from the web interface.
#
# Leave the _HOST values empty to skip seeding entirely.
SWITCH_NAME=switch-01
SWITCH_HOST=
SWITCH_VENDOR=

FORTIGATE_NAME=fortigate-01
FORTIGATE_HOST=

# ──────────────────────────────────────────────────────────────── lifecycle ──
# A discovered record not seen for this long is flagged, then removed.
# Static DHCP reservations and anything tagged PROTECTED_TAG are never deleted,
# and neither is anything you created by hand in the NetBox UI.
OFFLINE_AFTER_HOURS=48
DELETE_AFTER_DAYS=7

# Set false to keep everything at "Deprecated"/"Offline" and never delete.
ENABLE_AUTO_DELETE=true

PROTECTED_TAG=protected
